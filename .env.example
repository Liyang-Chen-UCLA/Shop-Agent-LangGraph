# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional override; packaged products.parquet is used when empty.
MARKET_DATASET_PATH=
# Optional directory for reusable market criteria/attributes keyed by taxonomy node.
# Defaults to .cache/market_nodes in the project directory.
MARKET_CACHE_DIR=
RELATION_CACHE_DIR=
TAVILY_API_KEY=

# LangSmith / LangGraph Studio
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=shop-agent-langgraph
